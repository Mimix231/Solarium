{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": ".test-dist",
    "rootDir": "src",
    "noEmit": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/blocks/protocol.ts",
    "src/blocks/data.ts",
    "src/blocks/exports.ts",
    "src/blocks/workflow.ts",
    "src/engine/activity.ts",
    "src/engine/sse.ts",
    "src/engine/reasoning.ts",
    "src/engine/capabilities.ts",
    "src/engine/tools.ts",
    "src/engine/llama.ts",
    "src/engine/agent.ts",
    "src/engine/continuous-generation.ts",
    "src/engine/backends.ts",
    "src/engine/search-intent.ts",
    "src/engine/duration.ts",
    "src/engine/catalog.ts",
    "tests/compile-shims.d.ts",
    "src/engine/context-window.ts",
    "src/blocks/preview-source.ts",
    "src/blocks/document.ts",
    "src/engine/task-intent.ts",
    "src/engine/project-context.ts",
    "src/engine/action-permissions.ts",
    "src/engine/live-workspace.ts",
    "src/engine/visual-actions.ts",
    "src/foundation/types.ts",
    "src/foundation/store.ts",
    "src/foundation/backup.ts",
    "src/writing/**/*.ts",
    "src/stories/**/*.ts",
    "src/research/**/*.ts"
  ]
}
