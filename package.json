{
  "name": "solarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test:glitch": "python -X utf8 backend/solarium_test.py -v",
    "test": "node scripts/generate-spica-registry.cjs --check && node scripts/check-syntax.cjs && tsc -p tsconfig.test.json && node scripts/set-test-commonjs.cjs && node --test tests/*.test.cjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "predev": "node scripts/clean-legacy-cosmic-theme.cjs && node scripts/clean-spica-misplaced-runtime-blocks.cjs && node scripts/generate-spica-registry.cjs --check && node scripts/check-frontend-dependencies.cjs && node scripts/source-identity.cjs",
    "prebuild": "node scripts/clean-legacy-cosmic-theme.cjs && node scripts/clean-spica-misplaced-runtime-blocks.cjs && node scripts/generate-spica-registry.cjs --check && node scripts/check-frontend-dependencies.cjs && node scripts/source-identity.cjs",
    "precheck": "node scripts/clean-legacy-cosmic-theme.cjs && node scripts/clean-spica-misplaced-runtime-blocks.cjs && node scripts/generate-spica-registry.cjs --check && node scripts/check-frontend-dependencies.cjs && node scripts/source-identity.cjs",
    "spica:registry": "node scripts/generate-spica-registry.cjs",
    "spica:registry:check": "node scripts/generate-spica-registry.cjs --check",
    "test:spica:phase01": "node scripts/check-spica-phase01.cjs",
    "test:spica:phase02": "node scripts/check-spica-phase02.cjs",
    "test:spica:phase03": "node scripts/check-spica-phase03.cjs",
    "test:spica:phase04": "node scripts/check-spica-phase04.cjs",
    "spica:runtime:registry": "node scripts/generate-spica-runtime-registry.cjs",
    "spica:runtime:registry:check": "node scripts/generate-spica-runtime-registry.cjs --check",
    "test:spica:phase05": "node scripts/check-spica-phase05.cjs",
    "spica:catalog:benchmark": "python -X utf8 scripts/benchmark-spica-catalog.py",
    "test:spica:phase06": "node scripts/check-spica-phase06.cjs",
    "test:spica:phase07": "node scripts/check-spica-phase07.cjs",
    "test:spica:phase08": "node scripts/check-spica-phase08.cjs",
    "test:spica:unified": "node --test tests/spica-block-unification.test.cjs",
    "test:spica:phase09": "node scripts/check-spica-phase09.cjs",
    "spica:blocks:cleanup": "node scripts/clean-spica-legacy-blocks.cjs",
    "spica:blocks:cleanup:check": "node scripts/clean-spica-legacy-blocks.cjs --check",
    "spica:runtime:cleanup": "node scripts/clean-spica-misplaced-runtime-blocks.cjs",
    "spica:runtime:cleanup:check": "node scripts/clean-spica-misplaced-runtime-blocks.cjs --check",
    "test:spica:contracts": "node --test tests/spica-tool-contract-intelligence.test.cjs",
    "test:tool:reliability": "node --test tests/tool-execution-reliability.test.cjs tests/spica-tool-contract-intelligence.test.cjs",
    "test:spica:phase95": "node scripts/check-spica-phase95.cjs",
    "test:spica:phase10": "node scripts/check-spica-phase10.cjs",
    "test:spica:phase10:reliability": "node scripts/check-spica-phase10-reliability.cjs",
    "test:spica:phase10:roundA": "node scripts/audit-spica-phase10-roundA.cjs && node scripts/check-spica-phase07.cjs && node scripts/check-spica-phase09.cjs && node scripts/check-spica-phase10.cjs && node --test tests/spica-tool-contract-intelligence.test.cjs",
    "test:spica:phase10:roundB": "node scripts/check-spica-phase10-roundB.cjs",
    "test:spica:phase10:roundC": "node scripts/check-spica-phase10-roundC.cjs",
    "test:spica:phase10:roundD": "node scripts/check-spica-phase10-roundD.cjs",
    "ui:cosmic:cleanup": "node scripts/clean-legacy-cosmic-theme.cjs",
    "ui:cosmic:cleanup:check": "node scripts/clean-legacy-cosmic-theme.cjs --check",
    "test:spica:phase10:roundE": "node scripts/check-spica-phase10-roundE.cjs",
    "test:spica:phase10:contextfix": "node scripts/check-spica-phase10-contextfix.cjs",
    "test:spica:phase10:roundF": "node scripts/check-spica-phase10-roundF.cjs",
    "test:spica:phase10:loopfix": "node scripts/check-spica-phase10-tool-loop.cjs",
    "test:construction:phase01": "node --test tests/dream-construction-phase01.test.cjs",
    "test:construction:phase02": "node scripts/check-dce-source-warehouse.cjs && node --test tests/dream-construction-phase02.test.cjs",
    "dce:source:manifest:check": "node scripts/check-dce-source-warehouse.cjs",
    "dce:source:types": "node scripts/check-dce-source-types.cjs",
    "test:construction:phase03": "node --test tests/dream-construction-phase03.test.cjs",
    "test:inference:continuity": "node --test tests/construction-inference-recovery.test.cjs tests/dce-inference-streaming.test.cjs tests/dce-context-rollover.test.cjs",
    "test:inference:inputfix": "node scripts/prepare-dce-inference-tests.cjs && node --test tests/dce-input-context-recovery.test.cjs tests/dce-inference-streaming.test.cjs tests/dce-context-rollover.test.cjs tests/context-window.test.cjs",
    "dce:warehouse:benchmark": "node scripts/benchmark-dce-phase03.cjs",
    "dce:warehouse:index": "node scripts/build-dce-warehouse-index.cjs"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.3",
